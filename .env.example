# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Krasnoyarsk

# База и очередь (для docker-compose значения проставляются автоматически)
# DATABASE_URL=postgres://vibetrack:vibetrack@db:5432/vibetrack
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# Без Redis — выполнять задачи синхронно (только для локальной разработки)
CELERY_TASK_ALWAYS_EAGER=0
VIBETRACK_INLINE_WORKER=1          # считать в фоновом потоке без Redis; 0 — через Celery

# Аудиодвижок
VIBETRACK_EXPORT_FORMAT=wav        # wav или mp3 (mp3 требует ffmpeg)
VIBETRACK_MAX_DURATION=480         # максимальная длина трека, секунды
VIBETRACK_MAX_UPLOAD_MB=80
VIBETRACK_MASTER_LOUDNESS_DB=-10
VIBETRACK_SEPARATION_BACKEND=auto  # auto | demucs | dsp
# VIBETRACK_KEEP_MODELS=1          # держать Demucs и Whisper в памяти между
                                   # рендерами: быстрее, но нужен запас памяти
# Demucs пропускается, если свободной памяти меньше оценки потребности.
# VIBETRACK_DEMUCS_MB_BASE=1200    # постоянная часть оценки, МБ
# VIBETRACK_DEMUCS_MB_PER_MIN=450  # сколько добавлять на минуту трека
# VIBETRACK_SKIP_MEMORY_CHECK=1    # не проверять память вовсе
# VIBETRACK_DEMUCS_SEGMENT=7.8     # короче куски — меньше пик памяти на CPU;
                                   # если Demucs откажется, разделение просто
                                   # уйдёт на DSP, рендер не упадёт
VIBETRACK_CAB_IR=                  # путь к wav-импульсу гитарного кабинета (их полно бесплатных)
# htdemucs — рабочий выбор для CPU; htdemucs_ft вчетверо медленнее и нужен
# только на GPU; htdemucs_6s добавляет дорожки гитары и пианино
VIBETRACK_DEMUCS_MODEL=htdemucs
VIBETRACK_DEMUCS_DEVICE=cpu
VIBETRACK_DEMUCS_SEGMENT=          # длина куска в секундах: меньше — ниже пик памяти на CPU
VIBETRACK_DEMUCS_SHIFTS=0          # >0 точнее, но кратно дольше
VIBETRACK_WHISPER_MODEL=medium     # tiny|base|small|medium|large-v3 (для русского — medium и выше)
VIBETRACK_WHISPER_DEVICE=cpu
VIBETRACK_WHISPER_COMPUTE=int8     # int8 на CPU, float16 на GPU
VIBETRACK_WHISPER_LANGUAGE=        # пусто — определять автоматически
VIBETRACK_MODEL_CACHE=             # куда класть веса (по умолчанию ~/.cache/vibetrack-models)
VIBETRACK_PRELOAD_MODELS=0         # 1 — греть модели при старте воркера
VIBETRACK_TORCH_THREADS=0          # 0 — по числу ядер
VIBETRACK_OPEN_API=1               # 1 — работать без логина, 0 — только авторизованным
VIBETRACK_REQUIRE_LOGIN=0          # 1 — обрабатывать треки только авторизованным (в проде: 1)
VIBETRACK_PAYMENTS_TEST_MODE=0     # 1 — покупка тарифа активируется сразу, без провайдера
VIBETRACK_UNLIMITED_USERS=         # логины через запятую — работают без лимитов
VIBETRACK_SAMPLES_DIR=             # папка с живыми сэмплами (по умолчанию samples/ в проекте)

# Генерация кавера внешней нейросетью по API — без GPU и без скачивания весов.
# Провайдер: none | suno_proxy | elevenlabs | stability | custom
VIBETRACK_MUSIC_PROVIDER=none
VIBETRACK_MUSIC_API_KEY=
# Настройки Stable Audio (провайдер stability)
VIBETRACK_STABILITY_STRENGTH=0.55  # 0.5-0.6 — лучший компромисс по слуху
VIBETRACK_STABILITY_MAX_SECONDS=190  # предел модели, выше поднять нельзя
VIBETRACK_STABILITY_STEPS=50   # только 30-100, вне диапазона Stability отвечает 400
VIBETRACK_STABILITY_FORMAT=mp3
# Описание запросов провайдера одним JSON — подключение нового сервиса
# не требует правки кода:
# VIBETRACK_MUSIC_API_CONFIG={"submit_url":"https://api.example/generate","status_url":"https://api.example/jobs/{job_id}","audio_field":"audio","prompt_field":"prompt","job_id_path":"id","status_path":"status","result_path":"output.url","done_values":["succeeded"]}
# VIBETRACK_MUSIC_API_HEADERS={"X-Api-Version":"2"}
# VIBETRACK_MUSIC_API_EXTRA={"model":"cover-v1"}
#
# ACE-Step 1.5 на RunPod Serverless -- образ ghcr.io/quang101182/acestep-serverless
# (base-чекпойнт: задача lego -- "дописать партии поверх исходника" -- есть
# ТОЛЬКО в base, в turbo её нет). Контракт прочитан из его handler.py:
#   вход  {"input": {"audio_b64": "...", "prompt": "...", "lyrics": "...",
#                    "duration": 242.1, "thinking": false}}
#   выход {"output": {"ok": true, "audio_b64": "...", "secondes": 131.4}}
# "thinking": false -- обязательно: при включённом "мышлении" lego молча
# игнорирует исходный трек и сочиняет своё (баг ACE-Step #1286, закрыт
# без исправления). GPU 24 ГБ (A5000/4090), трек ~4 мин считается ~2 мин.
# RunPod устроен не как обычный REST: только JSON, аудио -- base64 в теле,
# своего хостинга файлов нет; поэтому input_mode/output_mode/wrap_input_key.
# Живым вызовом ещё не проверено.
# VIBETRACK_MUSIC_PROVIDER=custom
# VIBETRACK_MUSIC_API_KEY=<ключ RunPod, rpa_...>
# VIBETRACK_MUSIC_API_CONFIG={"submit_url":"https://api.runpod.ai/v2/ВАШ_ENDPOINT_ID/run","status_url":"https://api.runpod.ai/v2/ВАШ_ENDPOINT_ID/status/{job_id}","input_mode":"json_base64","output_mode":"base64","wrap_input_key":"input","audio_field":"audio_b64","prompt_field":"prompt","result_path":"output.audio_b64","done_values":["COMPLETED"],"failed_values":["FAILED"],"poll_seconds":10,"timeout_seconds":1200}
# VIBETRACK_MUSIC_API_EXTRA={"thinking":false}

# Разбор описания аранжировки через LLM (~0,2-1 ₽ за рендер)
# ANTHROPIC_API_KEY=
VIBETRACK_LLM_ENABLED=auto         # auto (включить при наличии ключа) | 1 | 0
# VIBETRACK_LLM_MODEL=claude-opus-5  # дешевле: claude-sonnet-5, claude-haiku-4-5
